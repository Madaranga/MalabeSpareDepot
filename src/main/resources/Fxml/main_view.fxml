<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26">
  <tabs>
    <Tab text="Inventory Dashboard">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <VBox prefHeight="375.0" prefWidth="600.0">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <TextField fx:id="searchField" prefHeight="26.0" prefWidth="170.0" promptText="Search by Name or Brand . . ." />
                              <ComboBox fx:id="categoryFilter" prefWidth="150.0" />
                              <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#onSearch" text="Search" />
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                              <Label fx:id="lblTotalValue" text="Total Inventory Value: Rs. 0.00" />
                              <Label fx:id="lblTotalParts" text="Total Parts: 0" />
                           </children>
                        </HBox>
                        <TableView fx:id="inventoryTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colPartCode" prefWidth="75.0" text="Part Code" />
                            <TableColumn fx:id="colName" prefWidth="75.0" text="Name" />
                              <TableColumn fx:id="colBrand" prefWidth="75.0" text="Brand" />
                              <TableColumn fx:id="colPrice" prefWidth="75.0" text="Price (Rs. )" />
                              <TableColumn fx:id="colQty" prefWidth="75.0" text="Quantity" />
                              <TableColumn fx:id="colCategory" prefWidth="75.0" text="Category" />
                              <TableColumn fx:id="colDateAdded" prefWidth="75.0" text="Date Added" />
                          </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children></AnchorPane>
      </content>
    </Tab>
    <Tab text="Manage Items">
      <content>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
      </content>
    </Tab>
      <Tab text="Checkout &amp; Dealers">
         <content>
            <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
         </content>
      </Tab>
  </tabs>
</TabPane>
