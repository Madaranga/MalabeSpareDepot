               <Button mnemonicParsing="false" onAction="#onBrowseImage" text="Browse Image" GridPane.columnIndex="1" GridPane.rowIndex="6" />
               <ImageView fx:id="imgPreview" fitHeight="70.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="1" GridPane.rowIndex="7">
                  <GridPane.margin>
