                    <TextField fx:id="searchField" prefHeight="26.0" prefWidth="170.0" promptText="Search by Name or Brand . . ." />
                    <ComboBox fx:id="categoryFilter" prefWidth="150.0" />
                    <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#onSearch" text="Search" />
